{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.11.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceId":113558,"databundleVersionId":14456136,"isSourceIdPinned":false,"sourceType":"competition"},{"sourceId":4534,"sourceType":"modelInstanceVersion","isSourceIdPinned":false,"modelInstanceId":3326,"modelId":986},{"sourceId":648498,"sourceType":"modelInstanceVersion","isSourceIdPinned":false,"modelInstanceId":489174,"modelId":504592}],"dockerImageVersionId":31193,"isInternetEnabled":false,"language":"python","sourceType":"notebook","isGpuEnabled":true}},"nbformat_minor":4,"nbformat":4,"cells":[{"source":"<a href=\"https://www.kaggle.com/code/junaid512/recod-ai-luc-pro-pipline?scriptVersionId=281431431\" target=\"_blank\"><img align=\"left\" alt=\"Kaggle\" title=\"Open in Kaggle\" src=\"https://kaggle.com/static/images/open-in-kaggle.svg\"></a>","metadata":{},"cell_type":"markdown"},{"cell_type":"code","source":"\n\nfrom transformers import AutoImageProcessor, AutoModel\nfrom torch.utils.data import Dataset, DataLoader\nfrom tqdm.notebook import tqdm\nfrom pathlib import Path\nfrom PIL import Image\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport warnings\nimport torch\nimport json\nimport math\nimport cv2\nimport os\nimport random\nfrom sklearn.model_selection import train_test_split\nfrom scipy import stats\nfrom skimage import exposure, restoration\nfrom skimage.feature import local_binary_pattern\nimport albumentations as A\nfrom albumentations.pytorch import ToTensorV2\n\nwarnings.filterwarnings(\"ignore\")\nplt.style.use('seaborn-v0_8')\nsns.set_palette(\"husl\")\n\n# %% [markdown]\n# ## 2. Configuration Class (Enhanced)\n\nclass CFG:\n    # Paths\n    train_images_path = \"/kaggle/input/recodai-luc-scientific-image-forgery-detection/train_images\"\n    test_images_path = \"/kaggle/input/recodai-luc-scientific-image-forgery-detection/test_images\"\n    train_masks_path = \"/kaggle/input/recodai-luc-scientific-image-forgery-detection/train_masks\"\n    sample_sub_path = \"/kaggle/input/recodai-luc-scientific-image-forgery-detection/sample_submission.csv\"\n    \n    # Model paths\n    dino_path = \"/kaggle/input/dinov2/pytorch/base/1\"\n    dino_weights_path = \"/kaggle/input/m/ravaghi/dinov2/pytorch/base/1/model.pt\"\n    \n    # Device configuration\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    \n    # Image processing\n    img_size = 512\n    batch_size = 4\n    \n    # Inference settings\n    use_tta = True\n    tta_flip_horizontal = True\n    tta_flip_vertical = True\n    \n    # Post-processing hyperparameters (to be tuned)\n    alpha_grad = 0.35\n    threshold_multiplier = 0.3\n    morph_close_kernel = 5\n    morph_open_kernel = 3\n    \n    # Hyperparameter tuning ranges\n    alpha_grad_range = [0.2, 0.3, 0.35, 0.4, 0.5]\n    threshold_range = [0.2, 0.3, 0.4, 0.5]\n    kernel_range = [3, 5, 7]\n    \n    # EDA settings\n    eda_sample_size = 100\n    plot_dpi = 100\n    \n    # Random seed for reproducibility\n    seed = 42\n    \n    @staticmethod\n    def set_seed():\n        random.seed(CFG.seed)\n        np.random.seed(CFG.seed)\n        torch.manual_seed(CFG.seed)\n        if torch.cuda.is_available():\n            torch.cuda.manual_seed_all(CFG.seed)\n\nCFG.set_seed()\n\n# %% [markdown]\n# ## 3. EDA - Exploratory Data Analysis\n\ndef load_eda_data():\n    \"\"\"Load data for EDA analysis\"\"\"\n    # Load training data if available\n    if os.path.exists(CFG.train_images_path):\n        train_image_files = sorted(os.listdir(CFG.train_images_path))\n        print(f\"Found {len(train_image_files)} training images\")\n        \n        # Sample for EDA\n        eda_files = random.sample(train_image_files, min(CFG.eda_sample_size, len(train_image_files)))\n        \n        eda_data = []\n        for img_file in tqdm(eda_files, desc=\"Loading EDA data\"):\n            img_path = Path(CFG.train_images_path) / img_file\n            mask_path = Path(CFG.train_masks_path) / img_file.replace('.png', '_mask.png')\n            \n            if mask_path.exists():\n                image = Image.open(img_path).convert(\"RGB\")\n                mask = Image.open(mask_path).convert(\"L\")\n                \n                eda_data.append({\n                    'image_id': img_file,\n                    'image': image,\n                    'mask': mask,\n                    'width': image.width,\n                    'height': image.height,\n                    'mask_area': np.array(mask).sum() / 255,\n                    'is_forged': np.array(mask).sum() > 0\n                })\n        \n        return eda_data\n    else:\n        print(\"Training data not available for EDA. Using test data for basic analysis.\")\n        test_image_files = sorted(os.listdir(CFG.test_images_path))\n        return [{'image_id': f, 'image': Image.open(Path(CFG.test_images_path)/f).convert(\"RGB\")} \n                for f in random.sample(test_image_files, min(CFG.eda_sample_size, len(test_image_files)))]\n\n# Run EDA\neda_data = load_eda_data()\n\n# %% [markdown]\n# ### 3.1 Image Size Distribution\n\nif eda_data:\n    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 5), dpi=CFG.plot_dpi)\n    \n    # Image dimensions\n    widths = [item['width'] for item in eda_data]\n    heights = [item['height'] for item in eda_data]\n    \n    sns.histplot(widths, kde=True, ax=ax1, color='blue', bins=20)\n    ax1.set_title('Image Width Distribution')\n    ax1.set_xlabel('Width (pixels)')\n    \n    sns.histplot(heights, kde=True, ax=ax2, color='green', bins=20)\n    ax2.set_title('Image Height Distribution')\n    ax2.set_xlabel('Height (pixels)')\n    \n    plt.tight_layout()\n    plt.savefig('image_size_distribution.png', bbox_inches='tight')\n    plt.show()\n    \n    print(f\"Average image size: {np.mean(widths):.1f} x {np.mean(heights):.1f}\")\n    print(f\"Min size: {min(widths)} x {min(heights)}\")\n    print(f\"Max size: {max(widths)} x {max(heights)}\")\n\n# %% [markdown]\n# ### 3.2 Forgery Analysis (if training data available)\n\nif any('mask_area' in item for item in eda_data):\n    forged_items = [item for item in eda_data if item['is_forged']]\n    authentic_items = [item for item in eda_data if not item['is_forged']]\n    \n    print(f\"Forged images in sample: {len(forged_items)} ({len(forged_items)/len(eda_data)*100:.1f}%)\")\n    print(f\"Authentic images in sample: {len(authentic_items)} ({len(authentic_items)/len(eda_data)*100:.1f}%)\")\n    \n    if forged_items:\n        fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 5), dpi=CFG.plot_dpi)\n        \n        # Mask area distribution\n        mask_areas = [item['mask_area'] for item in forged_items]\n        sns.histplot(mask_areas, kde=True, ax=ax1, color='red', bins=15)\n        ax1.set_title('Forged Area Distribution')\n        ax1.set_xlabel('Number of forged pixels')\n        ax1.set_ylabel('Count')\n        \n        # Pixel intensity analysis\n        forged_pixels = []\n        authentic_pixels = []\n        \n        for item in eda_data:\n            img_array = np.array(item['image'])\n            mask_array = np.array(item['mask']) / 255\n            \n            # Sample pixels\n            if item['is_forged']:\n                forged_mask = mask_array > 0\n                if np.any(forged_mask):\n                    forged_pixels.append(img_array[forged_mask].mean(axis=(0,1)))\n            else:\n                authentic_pixels.append(img_array.mean(axis=(0,1)))\n        \n        if forged_pixels and authentic_pixels:\n            forged_pixels = np.array(forged_pixels)\n            authentic_pixels = np.array(authentic_pixels)\n            \n            ax2.boxplot([authentic_pixels[:,0], forged_pixels[:,0]], \n                       labels=['Authentic (R)', 'Forged (R)'], patch_artist=True)\n            ax2.set_title('Pixel Intensity Comparison (Red Channel)')\n            ax2.set_ylabel('Mean Intensity')\n        \n        plt.tight_layout()\n        plt.savefig('forgery_analysis.png', bbox_inches='tight')\n        plt.show()\n\n# %% [markdown]\n# ### 3.3 Visual Examples\n\nif eda_data:\n    # Show examples of forged and authentic images\n    fig, axes = plt.subplots(2, 3, figsize=(18, 10), dpi=CFG.plot_dpi)\n    fig.suptitle('Image Forgery Examples', fontsize=16)\n    \n    # Get forged and authentic examples\n    forged_examples = [item for item in eda_data if item.get('is_forged', False)][:3]\n    authentic_examples = [item for item in eda_data if not item.get('is_forged', False)][:3]\n    \n    for i, (ax, example) in enumerate(zip(axes[0], forged_examples)):\n        ax.imshow(example['image'])\n        ax.set_title(f'Forged Image: {example[\"image_id\"]}')\n        ax.axis('off')\n    \n    for i, (ax, example) in enumerate(zip(axes[1], authentic_examples)):\n        ax.imshow(example['image'])\n        ax.set_title(f'Authentic Image: {example[\"image_id\"]}')\n        ax.axis('off')\n    \n    plt.tight_layout()\n    plt.savefig('image_examples.png', bbox_inches='tight')\n    plt.show()\n\n# %% [markdown]\n# ### 3.4 Frequency Domain Analysis (Advanced EDA)\n\ndef analyze_frequency_domain(image, title):\n    \"\"\"Analyze image in frequency domain\"\"\"\n    img_gray = np.array(image.convert('L'))\n    \n    # Compute FFT\n    f = np.fft.fft2(img_gray)\n    fshift = np.fft.fftshift(f)\n    magnitude_spectrum = 20 * np.log(np.abs(fshift) + 1e-8)\n    \n    # Plot\n    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(10, 4), dpi=CFG.plot_dpi)\n    ax1.imshow(img_gray, cmap='gray')\n    ax1.set_title(f'{title} - Spatial Domain')\n    ax1.axis('off')\n    \n    ax2.imshow(magnitude_spectrum, cmap='viridis')\n    ax2.set_title(f'{title} - Frequency Domain')\n    ax2.axis('off')\n    \n    plt.tight_layout()\n    plt.savefig(f'frequency_analysis_{title.lower().replace(\" \", \"_\")}.png', bbox_inches='tight')\n    plt.show()\n\n# Analyze one forged and one authentic image if available\nif any('is_forged' in item for item in eda_data):\n    forged_img = next((item for item in eda_data if item.get('is_forged', False)), None)\n    authentic_img = next((item for item in eda_data if not item.get('is_forged', False)), None)\n    \n    if forged_img:\n        analyze_frequency_domain(forged_img['image'], 'Forged Image')\n    if authentic_img:\n        analyze_frequency_domain(authentic_img['image'], 'Authentic Image')\n\n# %% [markdown]\n# ## 4. Model Architecture (Same as Original)\n\nclass DinoTinyDecoder(nn.Module):\n    def __init__(self, in_ch=768, out_ch=1):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Conv2d(in_ch, 256, 3, padding=1), nn.ReLU(),\n            nn.Conv2d(256, 64, 3, padding=1), nn.ReLU(),\n            nn.Conv2d(64, out_ch, 1)\n        )\n\n    def forward(self, f, size):\n        return self.net(F.interpolate(f, size=size, mode=\"bilinear\", align_corners=False))\n\n\nclass DinoSegmenter(nn.Module):\n    def __init__(self, encoder, processor):\n        super().__init__()\n        self.encoder, self.processor = encoder, processor\n        \n        for p in self.encoder.parameters():\n            p.requires_grad = False\n        \n        self.seg_head = DinoTinyDecoder(768, 1)\n\n    def forward_features(self, x):\n        imgs = (x*255).clamp(0, 255).byte().permute(0, 2, 3, 1).cpu().numpy()\n        inputs = self.processor(images=list(imgs), return_tensors=\"pt\").to(x.device)\n        \n        with torch.no_grad():\n            feats = self.encoder(**inputs).last_hidden_state\n        \n        B, N, C = feats.shape\n        fmap = feats[:, 1:, :].permute(0, 2, 1)\n        s = int(math.sqrt(N-1))\n        fmap = fmap.reshape(B, C, s, s)\n        \n        return fmap\n\n    def forward_seg(self, x):\n        fmap = self.forward_features(x)\n        return self.seg_head(fmap, (CFG.img_size, CFG.img_size))\n\n# %% [markdown]\n# ## 5. Hyperparameter Tuning for Post-processing\n\ndef tune_postprocessing_parameters():\n    \"\"\"Grid search for optimal post-processing parameters\"\"\"\n    if not eda_data:\n        print(\"No training data available for hyperparameter tuning. Using default parameters.\")\n        return\n    \n    forged_items = [item for item in eda_data if item.get('is_forged', False)]\n    if len(forged_items) < 5:\n        print(\"Insufficient forged samples for tuning. Using default parameters.\")\n        return\n    \n    print(\"Starting hyperparameter tuning for post-processing...\")\n    \n    best_score = -1\n    best_params = {}\n    \n    # Load processor and encoder once\n    processor = AutoImageProcessor.from_pretrained(CFG.dino_path, local_files_only=True)\n    encoder = AutoModel.from_pretrained(CFG.dino_path, local_files_only=True).eval().to(CFG.device)\n    \n    model = DinoSegmenter(encoder, processor).to(CFG.device)\n    model.load_state_dict(torch.load(CFG.dino_weights_path))\n    model.eval()\n    \n    # Grid search\n    for alpha in CFG.alpha_grad_range:\n        for threshold_mult in CFG.threshold_range:\n            for kernel_size in CFG.kernel_range:\n                scores = []\n                \n                for item in tqdm(forged_items[:10], desc=f\"Tuning α={alpha}, thr={threshold_mult}, kernel={kernel_size}\", leave=False):\n                    # Run inference with current parameters\n                    try:\n                        image = item['image']\n                        image_array = np.array(image.resize((CFG.img_size, CFG.img_size)), np.float32) / 255\n                        image_array = torch.from_numpy(image_array).permute(2, 0, 1)[None].to(CFG.device)\n                        \n                        with torch.no_grad():\n                            preds = torch.sigmoid(model.forward_seg(image_array))[0,0].cpu().numpy()\n                        \n                        # Apply post-processing with current parameters\n                        gx = cv2.Sobel(preds, cv2.CV_32F, 1, 0, ksize=3)\n                        gy = cv2.Sobel(preds, cv2.CV_32F, 0, 1, ksize=3)\n                        grad_mag = np.sqrt(gx**2 + gy**2)\n                        grad_norm = grad_mag / (grad_mag.max() + 1e-6)\n                        enhanced = (1 - alpha) * preds + alpha * grad_norm\n                        enhanced = cv2.GaussianBlur(enhanced, (3, 3), 0)\n                        thr = np.mean(enhanced) + threshold_mult * np.std(enhanced)\n                        mask = (enhanced > thr).astype(np.uint8)\n                        mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((kernel_size, kernel_size), np.uint8))\n                        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((3, 3), np.uint8))\n                        \n                        # Resize to original size\n                        mask = cv2.resize(mask, item['image'].size, interpolation=cv2.INTER_NEAREST)\n                        \n                        # Calculate IoU with ground truth mask\n                        gt_mask = np.array(item['mask']) > 0\n                        pred_mask = mask > 0\n                        \n                        intersection = np.logical_and(gt_mask, pred_mask).sum()\n                        union = np.logical_or(gt_mask, pred_mask).sum()\n                        iou = intersection / (union + 1e-8)\n                        \n                        scores.append(iou)\n                    except Exception as e:\n                        print(f\"Error during tuning: {e}\")\n                        continue\n                \n                if scores:\n                    avg_score = np.mean(scores)\n                    if avg_score > best_score:\n                        best_score = avg_score\n                        best_params = {\n                            'alpha_grad': alpha,\n                            'threshold_multiplier': threshold_mult,\n                            'morph_close_kernel': kernel_size\n                        }\n    \n    if best_params:\n        print(f\"Best parameters found: {best_params} with IoU: {best_score:.4f}\")\n        # Update CFG with best parameters\n        for k, v in best_params.items():\n            setattr(CFG, k, v)\n    else:\n        print(\"No valid parameters found. Keeping defaults.\")\n\n# Run hyperparameter tuning\ntune_postprocessing_parameters()\n\n# %% [markdown]\n# ## 6. Enhanced Model Loading and Inference (Same Logic with Improvements)\n\n# Load processor and encoder\nprocessor = AutoImageProcessor.from_pretrained(CFG.dino_path, local_files_only=True)\nencoder = AutoModel.from_pretrained(CFG.dino_path, local_files_only=True).eval().to(CFG.device)\n\n# Load model with tuned parameters\nmodel = DinoSegmenter(encoder, processor).to(CFG.device)\nmodel.load_state_dict(torch.load(CFG.dino_weights_path))\nmodel.eval()\n\n# %% [markdown]\n# ## 7. Enhanced Inference Functions\n\ndef rle_encode(mask):\n    pixels = mask.T.flatten()\n    dots = np.where(pixels == 1)[0]\n    \n    if len(dots) == 0:\n        return \"authentic\"\n    \n    run_lengths = []\n    prev = -2\n    for b in dots:\n        if b > prev + 1:\n            run_lengths.extend((b + 1, 0))\n        run_lengths[-1] += 1\n        prev = b\n    \n    return json.dumps([int(x) for x in run_lengths])\n\n@torch.no_grad()\ndef predict_with_tta(model, image):\n    predictions = []\n\n    # Original prediction\n    pred = torch.sigmoid(model.forward_seg(image))\n    predictions.append(pred)\n\n    # Horizontal flip TTA\n    if CFG.tta_flip_horizontal:\n        pred = torch.sigmoid(model.forward_seg(torch.flip(image, dims=[3])))\n        predictions.append(torch.flip(pred, dims=[3]))\n\n    # Vertical flip TTA\n    if CFG.tta_flip_vertical:\n        pred = torch.sigmoid(model.forward_seg(torch.flip(image, dims=[2])))\n        predictions.append(torch.flip(pred, dims=[2]))\n\n    return torch.stack(predictions).mean(0)[0, 0].cpu().numpy()\n\n@torch.no_grad()\ndef predict(model, image):\n    return torch.sigmoid(model.forward_seg(image))[0,0].cpu().numpy()\n\ndef enhanced_postprocess(preds, original_size, alpha_grad=None, threshold_multiplier=None):\n    \"\"\"Enhanced post-processing with tuned parameters\"\"\"\n    if alpha_grad is None:\n        alpha_grad = CFG.alpha_grad\n    if threshold_multiplier is None:\n        threshold_multiplier = CFG.threshold_multiplier\n    \n    gx = cv2.Sobel(preds, cv2.CV_32F, 1, 0, ksize=3)\n    gy = cv2.Sobel(preds, cv2.CV_32F, 0, 1, ksize=3)\n    grad_mag = np.sqrt(gx**2 + gy**2)\n    grad_norm = grad_mag / (grad_mag.max() + 1e-6)\n    enhanced = (1 - alpha_grad) * preds + alpha_grad * grad_norm\n    enhanced = cv2.GaussianBlur(enhanced, (3, 3), 0)\n    thr = np.mean(enhanced) + threshold_multiplier * np.std(enhanced)\n    mask = (enhanced > thr).astype(np.uint8)\n    \n    # Apply morphological operations with tuned parameters\n    close_kernel = np.ones((CFG.morph_close_kernel, CFG.morph_close_kernel), np.uint8)\n    open_kernel = np.ones((CFG.morph_open_kernel, CFG.morph_open_kernel), np.uint8)\n    \n    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, close_kernel)\n    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, open_kernel)\n    \n    mask = cv2.resize(mask, original_size, interpolation=cv2.INTER_NEAREST)\n    \n    return mask\n\ndef infer_image(image):\n    image_array = np.array(image.resize((CFG.img_size, CFG.img_size)), np.float32) / 255\n    image_array = torch.from_numpy(image_array).permute(2, 0, 1)[None].to(CFG.device)\n    \n    if CFG.use_tta:\n        preds = predict_with_tta(model, image_array)\n    else:\n        preds = predict(model, image_array)\n    \n    mask = enhanced_postprocess(preds, image.size)\n    \n    area = int(mask.sum())\n    if area > 0:\n        resized_mask = cv2.resize(mask, (CFG.img_size, CFG.img_size), interpolation=cv2.INTER_NEAREST)\n        mean_inside = float(preds[resized_mask == 1].mean())\n    else:\n        mean_inside = 0.0\n\n    # Enhanced decision logic with tuned thresholds\n    if area < 400 or mean_inside < 0.3:\n        return \"authentic\", None    \n    \n    return \"forged\", mask\n\n# %% [markdown]\n# ## 8. Inference with Progress Tracking and Visualization\n\npredictions = []\nvisual_samples = []  # Store some samples for visualization\n\ntest_images = sorted(os.listdir(CFG.test_images_path))\ntotal_images = len(test_images)\n\nprint(f\"Starting inference on {total_images} test images...\")\nprint(f\"Using tuned parameters: alpha_grad={CFG.alpha_grad}, threshold_multiplier={CFG.threshold_multiplier}, \"\n      f\"close_kernel={CFG.morph_close_kernel}, open_kernel={CFG.morph_open_kernel}\")\n\nfor i, image_path in enumerate(tqdm(test_images, desc=\"Running Inference\")):\n    image = Image.open(Path(CFG.test_images_path)/image_path).convert(\"RGB\")\n    label, mask = infer_image(image)\n\n    if mask is None:\n        mask = np.zeros(image.size[::-1], np.uint8)\n    else:\n        mask = np.array(mask, dtype=np.uint8)\n\n    if label == \"authentic\":\n        annotation = \"authentic\"\n    else:\n        annotation = rle_encode((mask > 0).astype(np.uint8))\n\n    predictions.append({\n        \"case_id\": Path(image_path).stem,\n        \"annotation\": annotation,\n        \"label\": label,\n        \"mask_area\": int(mask.sum()) if mask is not None else 0\n    })\n    \n    # Save some samples for visualization\n    if i < 5 and mask is not None:\n        visual_samples.append({\n            'image': image,\n            'mask': mask,\n            'label': label,\n            'case_id': Path(image_path).stem\n        })\n\n# %% [markdown]\n# ## 9. Results Visualization\n\ndef visualize_results(samples):\n    \"\"\"Visualize inference results\"\"\"\n    if not samples:\n        return\n    \n    fig, axes = plt.subplots(len(samples), 3, figsize=(15, 5*len(samples)), dpi=CFG.plot_dpi)\n    if len(samples) == 1:\n        axes = axes.reshape(1, -1)\n    \n    fig.suptitle('Inference Results Visualization', fontsize=16)\n    \n    for i, sample in enumerate(samples):\n        image = sample['image']\n        mask = sample['mask']\n        label = sample['label']\n        case_id = sample['case_id']\n        \n        # Original image\n        axes[i, 0].imshow(image)\n        axes[i, 0].set_title(f'Case {case_id} - {label}')\n        axes[i, 0].axis('off')\n        \n        # Predicted mask\n        if mask is not None:\n            axes[i, 1].imshow(mask, cmap='hot', alpha=0.7)\n            axes[i, 1].set_title(f'Predicted Mask (Area: {mask.sum()} pixels)')\n        else:\n            axes[i, 1].imshow(np.zeros_like(image), cmap='gray')\n            axes[i, 1].set_title('No Forgery Detected')\n        axes[i, 1].axis('off')\n        \n        # Overlay\n        if mask is not None:\n            overlay = np.array(image).copy()\n            overlay[mask > 0] = [255, 0, 0]  # Red overlay for forged regions\n            axes[i, 2].imshow(overlay)\n            axes[i, 2].set_title('Forgery Overlay')\n        else:\n            axes[i, 2].imshow(image)\n            axes[i, 2].set_title('Authentic Image')\n        axes[i, 2].axis('off')\n    \n    plt.tight_layout()\n    plt.savefig('inference_results.png', bbox_inches='tight')\n    plt.show()\n\n# Visualize results\nvisualize_results(visual_samples)\n\n# %% [markdown]\n# ## 10. Results Analysis\n\n# Create DataFrame for analysis\nresults_df = pd.DataFrame(predictions)\n\n# Basic statistics\nprint(\"\\n=== Results Analysis ===\")\nprint(f\"Total images processed: {len(results_df)}\")\nprint(f\"Forged images detected: {len(results_df[results_df['label'] == 'forged'])} ({len(results_df[results